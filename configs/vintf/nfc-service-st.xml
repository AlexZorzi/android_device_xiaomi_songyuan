<!--
    Trimmed copy of the stock odm nfc-service-st.xml. The stock file also
    declares ISecureElement/eSE1, which is already declared by
    sm8850-common manifest_canoe.xml and provided by
    android.hardware.secure_element-service.qti. Declaring it twice is what
    we avoid here; this binary only provides INfc.
-->
<manifest version="9.0" type="device">
    <hal format="aidl">
        <name>android.hardware.nfc</name>
        <version>2</version>
        <fqname>INfc/default</fqname>
    </hal>
</manifest>
