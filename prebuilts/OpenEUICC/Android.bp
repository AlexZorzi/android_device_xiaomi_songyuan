// The APK ships with its JNI libs already extracted (no lib/arm64-v8a inside),
// so liblpac-jni must be installed separately or OpenEUICC dies at startup with
// UnsatisfiedLinkError on LpacJni.<clinit>.
android_app_import {
    name: "OpenEUICC",
    apk: "OpenEUICC.apk",
    presigned: true,
    preprocessed: true,
    privileged: true,
    system_ext_specific: true,
    required: [
        "liblpac-jni",
        "liblpac-jni-openeuicc-symlink",
    ],
    dex_preopt: {
        enabled: false,
    },
}

cc_prebuilt_library_shared {
    name: "liblpac-jni",
    srcs: ["liblpac-jni.so"],
    system_ext_specific: true,
    compile_multilib: "64",
    check_elf_files: false,
    strip: {
        none: true,
    },
    prefer: true,
}

// The APK's JNI libs were extracted at package time, so PackageManager's
// nativeLibraryDir is empty. Mirror the layout the app expects by pointing it
// at the system_ext copy, exactly as nezha does.
install_symlink {
    name: "liblpac-jni-openeuicc-symlink",
    installed_location: "priv-app/OpenEUICC/lib/arm64/liblpac-jni.so",
    symlink_target: "/system_ext/lib64/liblpac-jni.so",
    system_ext_specific: true,
}
